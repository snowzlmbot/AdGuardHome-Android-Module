#!/bin/sh
record=${IPTABLES_RECORD_FILE:-/tmp/iptables-record.log}
state=${IPTABLES_STATE_FILE:-${record}.state}
printf '%s\n' "$0 $*" >> "$record"
case "${IPTABLES_FAIL_MATCH:-}" in
  '') ;;
  *) printf '%s' "$*" | grep -F -- "$IPTABLES_FAIL_MATCH" >/dev/null && exit 1 ;;
esac
[ "${1:-}" = -w ] && shift 2
table=filter
if [ "${1:-}" = -t ]; then table=$2; shift 2; fi
cmd=${1:-}; [ -n "$cmd" ] || exit 2; shift
chain=${1:-}; [ -n "$chain" ] || exit 2; shift
mkdir -p "${state%/*}"
touch "$state"
case "$cmd" in
  -N) grep -Fx "chain|$table|$chain" "$state" >/dev/null 2>&1 || printf 'chain|%s|%s\n' "$table" "$chain" >> "$state" ;;
  -L) grep -Fx "chain|$table|$chain" "$state" >/dev/null 2>&1 ;;
  -F) sed -i "\#^rule|$table|$chain|#d" "$state" ;;
  -X) sed -i "\#^rule|$table|$chain|#d;\#^chain|$table|$chain$#d" "$state" ;;
  -A) printf 'rule|%s|%s|%s\n' "$table" "$chain" "$*" >> "$state" ;;
  -I) [ "${1:-}" = 1 ] && shift; printf 'rule|%s|%s|%s\n' "$table" "$chain" "$*" >> "$state" ;;
  -C) grep -Fx "rule|$table|$chain|$*" "$state" >/dev/null 2>&1 ;;
  -D) sed -i "\#^rule|$table|$chain|$*$#d" "$state" ;;
  *) exit 2 ;;
esac
